# Copy to .env. Variables already set in your shell take precedence.

# Any OpenAI-compatible endpoint works. Ollama (free, local) is the default:
#   ollama pull qwen2.5:7b-instruct
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=unused
# For OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

LLM_CONTEXT_TOKENS=32000
LLM_REPLY_TOKENS=1500
LLM_CONCURRENCY=4

CRM_DB_PATH=data/crm.sqlite3
REPLAY_DB_PATH=data/replays.sqlite3
